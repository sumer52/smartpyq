# Smart PYQ Backend Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENV=development
DEBUG=true
PORT=8080
HOST=0.0.0.0
APP_NAME="Smart PYQ API"
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite Database URL (for development without Docker)
# Format: sqlite:///path/to/database.db
DATABASE_URL=sqlite:///./smartpyq.db

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis URL for caching and sessions
REDIS_URL=redis://localhost:6379/0

# Celery Broker (Redis)
CELERY_BROKER_URL=redis://localhost:6379/1

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=50
REDIS_RETRY_ON_TIMEOUT=true

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_SECONDS=900
JWT_REFRESH_EXPIRE_SECONDS=604800

# =============================================================================
# AI API KEYS
# =============================================================================
# Google Gemini API Key (Primary)
GEMINI_API_KEY=AIzaSyArfBwsHX6w6uXC5zpaQ5vTtFO8KinpIqI

# OpenAI API Key (Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# AI Configuration
AI_DEFAULT_MODEL=gemini-pro
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=30

# =============================================================================
# CLOUD STORAGE CONFIGURATION
# =============================================================================
# Storage Backend: 'firebase', 's3', or 'local'
STORAGE_BACKEND=s3

# Firebase Storage
FIREBASE_BUCKET=your-firebase-bucket-name
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-east-1
AWS_ENDPOINT_URL=  # Leave empty for AWS, set for MinIO/LocalStack

# Local Storage (Development)
LOCAL_STORAGE_PATH=./uploads

# File Upload Settings
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx
SIGNED_URL_TTL_SECONDS=300

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Email Settings
FROM_EMAIL=noreply@smartpyq.com
FROM_NAME=Smart PYQ
REPLY_TO_EMAIL=support@smartpyq.com

# Email Templates
EMAIL_TEMPLATES_DIR=./app/templates/email

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,smartpyq.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://smartpyq.com
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Security Headers
SECURE_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"

# Session Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# =============================================================================
# CELERY WORKER CONFIGURATION
# =============================================================================
# Celery Settings
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Worker Configuration
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Task Configuration
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY=60

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache Settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_CONNECTIONS=100
CACHE_KEY_PREFIX=smartpyq:

# Session Cache
SESSION_CACHE_TTL=1800
CHAT_CACHE_TTL=3600
QUERY_CACHE_TTL=300

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature Toggles
ENABLE_CHAT=true
ENABLE_FILE_UPLOAD=true
ENABLE_NEWSLETTER=true
ENABLE_ANALYTICS=true
ENABLE_ADMIN_PANEL=true

# AI Features
ENABLE_STREAMING_CHAT=true
ENABLE_CHAT_HISTORY=true
ENABLE_CONTEXT_MEMORY=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development Features
ENABLE_DOCS=true
ENABLE_REDOC=true
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILER=false

# Testing
TEST_DATABASE_URL=postgresql://smartpyq_user:smartpyq_password@localhost:5432/smartpyq_test
TEST_REDIS_URL=redis://localhost:6379/15

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and set these for production deployment

# ENV=production
# DEBUG=false
# LOG_LEVEL=WARNING
# SENTRY_TRACES_SAMPLE_RATE=0.01
# SESSION_COOKIE_SECURE=true
# CORS_ALLOW_CREDENTIALS=false
# ENABLE_DOCS=false
# ENABLE_REDOC=false

# Production Database (use connection pooling)
# DATABASE_URL=postgresql://user:pass@prod-db:5432/smartpyq?sslmode=require

# Production Redis (use Redis Cluster or ElastiCache)
# REDIS_URL=redis://prod-redis:6379/0?ssl_cert_reqs=required

# Production Storage (use managed services)
# AWS_S3_BUCKET=smartpyq-prod-bucket
# FIREBASE_BUCKET=smartpyq-prod.appspot.com

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================
# Add your custom environment variables here

# University/College Configuration
DEFAULT_TENANT_DOMAIN=university.edu
TENANT_SIGNUP_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true

# Paper Processing
PDF_PROCESSING_TIMEOUT=300
OCR_ENABLED=true
THUMBNAIL_GENERATION=true
WATERMARK_ENABLED=true

# Newsletter
NEWSLETTER_BATCH_SIZE=100
NEWSLETTER_SEND_INTERVAL=3600

# Analytics
ANALYTICS_RETENTION_DAYS=90
TRENDING_TOPICS_COUNT=10

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit .env file to version control
# 2. Use strong, unique passwords and API keys
# 3. Rotate secrets regularly
# 4. Use environment-specific configurations
# 5. Validate all environment variables on startup
# 6. Use secrets management in production (AWS Secrets Manager, etc.)
# 7. Enable SSL/TLS in production
# 8. Use managed services for databases and caching in production
# 9. Monitor resource usage and adjust limits accordingly
# 10. Test configuration changes in staging environment first